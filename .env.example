# General
PORT=8000
NODE_ENV=development
BASE_PATH="/api/v1"
DOMAIN_URL="localhost"
NGINX_SERVER_NAME="localhost"
TRUST_PROXY="false"
BCRYPT_SALT_ROUNDS=12

# Frontend Origins (comma-separated)
FRONTEND_ORIGINS="http://localhost:3000"

# PostgreSQL Database
POSTGRES_USER="your_username"
POSTGRES_PASSWORD="your_password"
POSTGRES_DB="authkit"
DATABASE_URL="postgresql://your_username:your_password@postgres:5432/authkit?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="your_secure_redis_password_here"
REDIS_TLS="false"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8000/api/v1/oauth/google/callback"

# Security Tokens & Secrets
# -------------------------
# Run `pnpm generate:secrets` to generate all these values securely.
# They will be output to `generated-secrets.json`, from where you can copy them here.

# JWT Authentication (Generate using: pnpm generate:secrets)
JWT_SECRET="your_jwt_secret_minimum_32_characters_long"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_minimum_32_characters_long"
JWT_RESET_SECRET="your_jwt_reset_secret_minimum_32_characters_long"
JWT_MFA_LOGIN_SECRET="your_jwt_mfa_login_secret_minimum_32_characters_long"

# Resend Email Service
RESEND_API_KEY="your-resend-api"
RESEND_SENDER_EMAIL="noreply@yourdomain.com"

# Authenticator App Secret (Must be >= 32 bytes of secure entropy)
AUTHENTICATOR_APP_SECRET="your_authenticator_app_secret_minimum_32_bytes_long"

# OIDC Configuration (Comma-separated list for cookie encryption)
OIDC_COOKIE_KEYS="cookie_signing_key_1_at_least_32_bytes_long,cookie_signing_key_2"

# JSON Web Key Set (JWKS) for signing tokens (MUST be a valid JSON string)
OIDC_JWKS='{"keys": []}'
