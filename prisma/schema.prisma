generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// USER & AUTHENTICATION
// =====================================================

enum Role {
  USER
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Multi-Factor Authentication
  twoFactorSecret String?
  enable2FA       Boolean  @default(false)
  backupCodes     String[] @default([])

  // Auth Relations
  sessions       Session[]
  accounts       Account[]
  authenticators Authenticator[]

  @@map("user")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Session {
  id        String    @id @default(cuid())
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String
  userAgent String
  isRevoked Boolean   @default(false)
  revokedAt DateTime?

  // Device fingerprinting
  deviceFingerprint String
  isNewDevice       Boolean @default(false)

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@index([userId])
  @@index([userId, deviceFingerprint])
  @@index([userId, isRevoked, expiresAt])
}

model OidcClient {
  id           String   @id @default(cuid())
  clientName   String
  clientId     String   @unique
  clientSecret String
  redirectUrls String[]
  grantTypes   String[]
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("oidc_client")
}

// =====================================================
// AUDIT LOGGING
// =====================================================

enum AuditAction {
  LOGIN
  LOGOUT
  FAILED_LOGIN
  PASSWORD_CHANGE
  PASSWORD_RESET
  MFA_ENABLE
  MFA_DISABLE
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  ROLE_CHANGE
  OIDC_CLIENT_CREATE
  SESSION_REVOKE
  WEBAUTHN_REGISTER
  WEBAUTHN_AUTHENTICATE
  WEBAUTHN_DELETE
  OTHER
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  entityType  String
  entityId    String?
  description String
  status      AuditStatus @default(SUCCESS)
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@map("audit_log")
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([status])
}

// =====================================================
// WEBHOOKS / EVENT SYSTEM
// =====================================================

enum WebhookSubscriptionStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILURE
  RETRIES_EXCEEDED
}

model WebhookSubscription {
  id                      String                    @id @default(cuid())
  name                    String
  url                     String
  description             String?
  status                  WebhookSubscriptionStatus @default(ACTIVE)
  secret                  String
  previousSecret          String?
  previousSecretExpiresAt DateTime?
  events                  String[]
  createdBy               String?
  lastDeliveryAt          DateTime?
  lastSuccessAt           DateTime?
  failureCount            Int                       @default(0)
  disabledAt              DateTime?
  disabledReason          String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  deliveries WebhookDelivery[]

  @@map("webhook_subscription")
  @@index([status])
  @@index([createdAt])
}

model WebhookDelivery {
  id                    String                @id @default(cuid())
  webhookSubscriptionId String
  subscription          WebhookSubscription   @relation(fields: [webhookSubscriptionId], references: [id], onDelete: Cascade)
  eventId               String
  eventType             String
  eventVersion          Int                   @default(1)
  attemptNumber         Int                   @default(1)
  status                WebhookDeliveryStatus @default(PENDING)
  httpStatus            Int?
  requestTimestamp      DateTime              @default(now())
  responseTimestamp     DateTime?
  duration              Int?
  nextRetryAt           DateTime?
  errorCode             String?
  errorMessage          String?
  requestPayload        Json?
  responseBody          String?
  isTest                Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@map("webhook_delivery")
  @@index([webhookSubscriptionId])
  @@index([eventId])
  @@index([eventType])
  @@index([status])
  @@index([nextRetryAt])
  @@index([createdAt])
}

// =====================================================
// WEBAUTHN / PASSKEYS
// =====================================================

model Authenticator {
  id                  String    @id @default(cuid())
  credentialId        String    @unique
  credentialPublicKey Bytes
  counter             BigInt    @default(0)
  transports          String[]  @default([])
  name                String?
  deviceType          String?
  backedUp            Boolean   @default(false)
  aaguid              String?
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("authenticator")
  @@index([userId])
  @@index([credentialId])
}


